<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/background"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="horizontal">
		<ImageView
			android:id="@+id/holder_icon"
			android:layout_width="28dp"
			android:layout_height="28dp"
			android:padding="5dp"
			android:background="@color/colorPrimary"
			android:src="@drawable/app_icon"
			android:scaleType="fitXY"
			android:focusable="false" />
		<LinearLayout
			android:id="@+id/menu"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="6dp"
			android:padding="4dp"
			android:background="#000000"
			android:gravity="left|center_vertical"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/signalitem"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginRight="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/signal_icon"
					android:layout_width="18dp"
					android:layout_height="18dp"
					android:padding="2dp"
					android:src="@drawable/icon_signal"
					android:scaleType="fitXY"
					android:focusable="false" />
				<TextView
					android:id="@+id/signal_value"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="7ms"
					android:textSize="10sp"
					android:textColor="#FFFFFF"
					android:singleLine="true"
					android:focusable="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/bateraiitem"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginRight="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<ru.ino.senseix.RogBatteryView
					android:id="@+id/battery_icon"
					android:layout_width="8dp"
					android:layout_height="16dp"
					android:layout_marginRight="5dp"
					android:src="@drawable/icon_battery"
					android:focusable="false" />
				<TextView
					android:id="@+id/battery_value"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="100%"
					android:textSize="10sp"
					android:textColor="#FFFFFF"
					android:singleLine="true"
					android:focusable="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/suhuitem"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginRight="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/thermostat_icon"
					android:layout_width="16dp"
					android:layout_height="16dp"
					android:padding="2dp"
					android:src="@drawable/icon_thermostat"
					android:scaleType="fitXY"
					android:focusable="false" />
				<TextView
					android:id="@+id/thermostat_value"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="21°C"
					android:textSize="10sp"
					android:textColor="#FFFFFF"
					android:singleLine="true"
					android:focusable="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/fpsitem"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginRight="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/fps_icon"
					android:layout_width="16dp"
					android:layout_height="16dp"
					android:padding="2dp"
					android:src="@drawable/icon_layers"
					android:scaleType="fitXY"
					android:focusable="false" />
				<TextView
					android:id="@+id/fps_value"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="60 FPS"
					android:textSize="10sp"
					android:textColor="#FFFFFF"
					android:singleLine="true"
					android:focusable="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/waktuitem"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal">
				<ImageView
					android:id="@+id/time_icon"
					android:layout_width="16dp"
					android:layout_height="16dp"
					android:padding="3dp"
					android:src="@drawable/icon_time"
					android:scaleType="fitXY"
					android:focusable="false" />
				<TextView
					android:id="@+id/time_value"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginRight="2dp"
					android:text="21.06.07"
					android:textSize="10sp"
					android:textColor="#FFFFFF"
					android:singleLine="true"
					android:layout_weight="1"
					android:focusable="false" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
