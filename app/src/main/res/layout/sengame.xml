<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<FrameLayout
		android:id="@+id/background"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#000000"
		android:orientation="vertical">
		<FrameLayout
			android:id="@+id/mainscreen"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#000000"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/previewicon"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="8dp"
				android:orientation="horizontal"
				android:translationX="121.0dp" />
			<LinearLayout
				android:id="@+id/gamelistframebg"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/toolbar"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="left|center_vertical"
					android:orientation="horizontal">
					<LinearLayout
						android:id="@+id/exitbtn"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_margin="8dp"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal">
						<ImageView
							android:id="@+id/icon_stop"
							android:layout_width="32dp"
							android:layout_height="32dp"
							android:src="@drawable/icon_stop"
							android:scaleType="fitXY" />
						<TextView
							android:id="@+id/exitbtntext"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:text="EXIT"
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/titlebar"
						android:layout_width="wrap_content"
						android:layout_height="0dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/appname"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:gravity="center_horizontal|center_vertical"
							android:text="Sengame"
							android:textSize="21sp"
							android:textColor="#FFFFFF" />
						<TextView
							android:id="@+id/manufactur"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Powered by InoOS"
							android:textSize="12sp"
							android:textColor="#BDBDBD"
							android:singleLine="true" />
					</LinearLayout>
					<ru.ino.senseix.OuiBatteryView
						android:id="@+id/ouibattery"
						android:layout_width="34dp"
						android:layout_height="22dp"
						android:layout_marginTop="8dp"
						android:layout_marginRight="14dp"
						android:layout_marginBottom="8dp" />
					<TextView
						android:id="@+id/clock"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginRight="13dp"
						android:text="21:67"
						android:textSize="21sp"
						android:textStyle="bold"
						android:textColor="#FFFFFF" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/gamelistbg"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="horizontal">
					<ListView
						android:id="@+id/list"
						android:layout_width="310dp"
						android:layout_height="match_parent"
						android:padding="8dp"
						android:choiceMode="none"
						android:scrollbars="none"
						android:listSelector="@android:color/transparent"
						android:divider="@null"
						android:fadingEdgeLength="40dp"
						android:requiresFadingEdge="vertical"
						tools:listitem="@layout/apps" />
					<LinearLayout
						android:id="@+id/editor_background"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="8dp"
						android:gravity="right|bottom"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/applicationdetailbg"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="21dp"
							android:gravity="right|center_vertical"
							android:orientation="vertical">
							<TextView
								android:id="@+id/selected_appname"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:text="@string/app_name"
								android:textSize="25sp"
								android:textColor="#FFFFFF"
								android:singleLine="true" />
							<LinearLayout
								android:id="@+id/versionbg"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginRight="6dp"
								android:layout_marginBottom="21dp"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/selected_appversion"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:padding="8dp"
									android:text="0.98.21"
									android:textSize="12sp"
									android:textColor="#BDBDBD"
									android:singleLine="true" />
							</LinearLayout>
							<LinearLayout
								android:id="@+id/buttonrow"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:padding="8dp"
								android:gravity="center_horizontal|center_vertical"
								android:orientation="horizontal">
								<LinearLayout
									android:id="@+id/restorebtn"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginRight="8dp"
									android:padding="8dp"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical">
									<ImageView
										android:id="@+id/icon_resetore"
										android:layout_width="32dp"
										android:layout_height="32dp"
										android:src="@drawable/icon_restore"
										android:scaleType="fitXY" />
								</LinearLayout>
								<LinearLayout
									android:id="@+id/setbtn"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_marginRight="8dp"
									android:padding="8dp"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical">
									<ImageView
										android:id="@+id/icon_set"
										android:layout_width="32dp"
										android:layout_height="32dp"
										android:src="@drawable/icon_image"
										android:scaleType="fitXY" />
								</LinearLayout>
								<LinearLayout
									android:id="@+id/playbtn"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:paddingVertical="8dp"
									android:paddingLeft="8dp"
									android:paddingRight="9dp"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="horizontal">
									<ImageView
										android:id="@+id/icon_play"
										android:layout_width="32dp"
										android:layout_height="32dp"
										android:src="@drawable/icon_play"
										android:scaleType="fitXY" />
									<TextView
										android:id="@+id/playbtntext"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:paddingHorizontal="8dp"
										android:text="PLAY"
										android:textSize="14sp"
										android:textStyle="bold"
										android:textColor="#FFFFFF"
										android:singleLine="true" />
								</LinearLayout>
							</LinearLayout>
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
		</FrameLayout>
		<LinearLayout
			android:id="@+id/splashscreen"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#000000"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical">
			<ru.ino.senseix.VideoLayout
				android:id="@+id/videosplash"
				android:layout_width="280dp"
				android:layout_height="280dp"
				android:padding="8dp"
				android:orientation="horizontal" />
		</LinearLayout>
	</FrameLayout>
</LinearLayout>
