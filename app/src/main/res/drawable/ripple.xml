<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40888888"> <!-- Mengubah warna ripple ke abu-abu transparan -->

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>

    <!-- Mask memastikan efek ripple tetap berada di dalam batas background -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/> <!-- Mask cukup gunakan warna solid -->
        </shape>
    </item>
</ripple>
